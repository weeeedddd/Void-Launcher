{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "bootstrapper-main",
  "description": "Least-privilege capabilities for the standalone Void Bootstrapper window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "dialog:allow-open"
  ]
}

