# Copy to `.env` and fill in — or export these in your shell before `npm run tauri dev`.
# (The Rust backend reads real environment variables; a .env file is just a
#  convenient place to keep them. Load it with `source .env` or a dotenv tool.)

# CurseForge Core API key — get one for free at https://console.curseforge.com/
# Sent as the `x-api-key` header. Modrinth needs NO key.
CURSEFORGE_API_KEY=
