{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Void Bootstrapper",
  "version": "0.1.4",
  "identifier": "dev.void.bootstrapper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Void Bootstrapper",
        "width": 920,
        "height": 620,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "decorations": false,
        "resizable": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: data:; media-src 'none'; connect-src 'self' ipc: http://ipc.localhost http://localhost:1430 ws://localhost:1430; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
