{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Void Launcher",
  "version": "0.1.4",
  "identifier": "dev.void.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:client",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Void Launcher",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 660,
        "center": true,
        "decorations": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: data: https:; media-src 'self' asset: data:; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; frame-src 'none'; object-src 'none'; base-uri 'self'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["voidlauncher"]
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
